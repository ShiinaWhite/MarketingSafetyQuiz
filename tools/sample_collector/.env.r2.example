# ---- Cloudflare R2 配置模板（R2_FAST_TRANSFER_V1） ----
#
# 用法：复制本文件为同目录下的 .env.r2.local，填入真实值。
#   cp tools/sample_collector/.env.r2.example tools/sample_collector/.env.r2.local
#
# 安全约束（必须遵守）：
#   - .env.r2.local 已在 .gitignore 中，绝不提交、绝不贴到聊天/issue
#   - 这五个值只允许存在于 PC 本机。绝不进入 Git / JS bundle / APK /
#     latest.json / run.json / 日志 / HTTP 错误响应
#   - 不要复用 Cloudflare 全局 API Token；只创建下面这种 R2 专用 S3 credential
#
# 取值位置见 tools/r2/setup_r2.md（含 Dashboard 精确路径与 wrangler 一键脚本）

# Cloudflare 账号 ID（32 位 hex）
R2_ACCOUNT_ID=

# R2 S3 API credential（Dashboard → R2 → API → Manage API Tokens → Create API Token）
# 权限选择「Object Read & Write」，并只授权下面两个 bucket（least privilege）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 公开 APK 下载 bucket（绑定 Custom Domain download.shiinalab.top，允许匿名 GET）
R2_DOWNLOAD_BUCKET=marketing-safety-quiz-downloads

# 私有样本 bucket（必须保持 PRIVATE，只经 S3 API / presigned URL 访问）
R2_SAMPLE_BUCKET=marketing-safety-quiz-samples
