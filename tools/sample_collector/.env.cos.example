# ---- 腾讯云 COS 配置模板（COS_SAMPLE_TRANSFER_POC / V1） ----
#
# 用法：复制本文件为同目录下的 .env.cos.local，填入真实值。
#   cp tools/sample_collector/.env.cos.example tools/sample_collector/.env.cos.local
#
# 安全约束（必须遵守）：
#   - .env.cos.local 已在 .gitignore 中，绝不提交、绝不贴到聊天/issue
#   - SecretId / SecretKey 只允许存在于 PC 本机（Collector 进程内）
#   - 绝不进入 Git / JS bundle / APK / latest.json / run.json / 日志 / HTTP 错误响应
#   - 手机端永远只拿短时（300 秒）presigned PUT URL，绝不持有长期 SecretKey
#   - CAM 子账号（如 msq-cos-uploader）只授最小权限，绝不加 QcloudCOSFullAccess
#
# COS 侧约定：
#   - Bucket 保持「私有读写」，绝不为测试临时改 public
#   - 对象 key 由服务器派生：samples/<yyyy-mm-dd>/<sampleId>/capture.jpg
#   - 生命周期：samples/ 30 天后删除（云端只是暂存层，PC real_samples 才是长期副本）

# 腾讯云 CAM 子账号的 SecretId（访问密钥 ID，非机密但也不应公开）
COS_SECRET_ID=

# 腾讯云 CAM 子账号的 SecretKey（机密，只存在于本机）
COS_SECRET_KEY=

# Bucket 名（含 APPID 后缀）
COS_BUCKET=marketing-safety-quiz-samples-1317873190

# 地域
COS_REGION=ap-beijing

# APPID
COS_APPID=1317873190
